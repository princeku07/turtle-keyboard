<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.google.ai.edge.aicore" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required on Android 13+ for the Notion result notification. The system silently
         drops notifications without this; the host activity is responsible for asking. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Required on Android 11+ to read display name & icon of host apps for the
             enrollment banner and per-app personalization. Add a package here whenever a
             new starter shortcut catalog is added in StaticSuggestedShortcutSource, or the
             banner will fall back to showing the raw package name with no icon. -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="com.phonepe.app.preprod" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.Slack" />
        <package android:name="com.whatsapp" />
        <package android:name="com.notion.id" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.discord" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.linkedin.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".TurtleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TurtleKeyboard"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TurtleKeyboard.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FeatureOnboardingActivity"
            android:exported="false"
            android:label="Welcome"
            android:theme="@style/Theme.TurtleKeyboard.FeatureOnboarding" />

        <activity
            android:name=".ui.CommandsActivity"
            android:exported="false"
            android:label="Commands"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.IntegrationsActivity"
            android:exported="false"
            android:label="Integrations"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AppPersonalizationActivity"
            android:exported="false"
            android:label="App personalization"
            android:parentActivityName=".ui.CommandsActivity" />

        <activity
            android:name=".ui.CommandPinsActivity"
            android:exported="false"
            android:label="Customize commands"
            android:parentActivityName=".ui.AppPersonalizationActivity" />

        <activity
            android:name=".ai.ImagePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TurtleKeyboard.PickerShim" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="History"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.TurtleKeyboard.Dark" />

        <activity
            android:name=".ui.HistoryPreviewActivity"
            android:exported="false"
            android:label="Preview"
            android:parentActivityName=".ui.HistoryActivity"
            android:theme="@style/Theme.TurtleKeyboard.Modal" />

        <activity
            android:name=".ui.SpriteToGifTestActivity"
            android:exported="false"
            android:label="Sprite → GIF test"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".integration.drive.DriveLinkActivity"
            android:exported="false"
            android:label="Connect Drive"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.mcp.McpServersActivity"
            android:exported="false"
            android:label="MCP Servers"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.mcp.McpAddBindingActivity"
            android:exported="false"
            android:label="Add MCP binding"
            android:parentActivityName=".ui.mcp.McpServersActivity" />

        <!-- Bottom-sheet overlay host. Launched by tapping a Turtle App Link
             (https://www.turtlekeyboard.com/<routeKey>/<id>) from a chat / share intent. The
             activity itself is a thin shell; the registered SheetView (see
             KeyboardIntegration.sheetRoutes) provides the actual UI. autoVerify="true"
             needs assetlinks.json hosted at https://www.turtlekeyboard.com/.well-known/assetlinks.json
             — until that's in place, Android shows a chooser instead of opening Turtle
             directly. Update the host here AND OverlayUrls.HOST in lockstep. -->
        <activity
            android:name=".overlay.BottomSheetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.TurtleKeyboard.BottomSheet">
            <!-- HTTPS App Link. assetlinks.json must be served at
                 https://www.turtlekeyboard.com/.well-known/assetlinks.json (file lives in
                 lading-app/public/.well-known/assetlinks.json — deployed via Vercel).
                 autoVerify runs on install; without a reachable file Android 12+
                 silently routes taps to the browser. Re-run after fresh install with:
                 adb shell pm get-app-links com.prince.turtlekeyboard
                 — host should report "verified". -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.turtlekeyboard.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ime.TurtleInputMethodService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>