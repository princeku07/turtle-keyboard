<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <include layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/integrations_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_3xl">

            <TextView
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="Connect a service to unlock its slash commands. Everything is per-account and revokable." />

            <!-- Cards added programmatically by IntegrationsActivity. -->
        </LinearLayout>
    </ScrollView>
</LinearLayout>
