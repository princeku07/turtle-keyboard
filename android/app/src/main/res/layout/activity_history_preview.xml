<?xml version="1.0" encoding="utf-8"?>
<!-- Root is SwipeDismissLayout so the whole sheet can be flicked away. The
     activity uses Theme.TurtleKeyboard.Modal (translucent window) so the
     underlying HistoryActivity grid peeks through as the sheet slides + fades. -->
<com.prince.turtlekeyboard.ui.SwipeDismissLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <!-- ===== Top bar: close (×) + tag + relative time ===== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/topbar_margin"
        android:paddingEnd="@dimen/topbar_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="@dimen/size_topbar_btn"
            android:layout_height="@dimen/size_topbar_btn"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tag_command"
            style="@style/TextMonoGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:textSize="15sp"
            tools:text="/cap" />

        <TextView
            android:id="@+id/tag_type"
            style="@style/TextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mono"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            tools:text="GIF" />

        <TextView
            android:id="@+id/tag_time"
            style="@style/TextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            tools:text="2m ago" />
    </LinearLayout>

    <!-- ===== Image stage ===== -->

    <!-- Horizontal swipe between history entries. Each page hosts its own
         ZoomableImageView (recycled by the RecyclerView pool inside ViewPager2),
         so pinch + pan state resets cleanly when the page changes. The pager
         doesn't intercept touches while a page is zoomed because the child view
         calls requestDisallowInterceptTouchEvent(true) on its parents. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/preview_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ===== Prompt + actions ===== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:id="@+id/prompt_card"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prompt" />

            <TextView
                android:id="@+id/prompt_text"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                tools:text="a samurai cat at sunset, oil paint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_md">

            <Button
                android:id="@+id/btn_share"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Share" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/ButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="Delete" />
        </LinearLayout>
    </LinearLayout>
</com.prince.turtlekeyboard.ui.SwipeDismissLayout>
