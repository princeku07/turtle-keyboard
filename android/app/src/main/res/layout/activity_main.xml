<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_root"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3xl"
        android:paddingBottom="@dimen/space_4xl">

        <!-- ===== Hero ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                android:text="🐢 Turtle" />

            <TextView
                android:id="@+id/hero_version"
                style="@style/TextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_title"
            style="@style/TextHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            tools:text="Ready to slash." />

        <TextView
            android:id="@+id/hero_sub"
            style="@style/TextSubhero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_2xl"
            android:textSize="16sp"
            tools:text="Type /cap, /poll, or /us in any app." />

        <!-- ===== Status hero card ===== -->

        <LinearLayout
            android:id="@+id/status_card"
            style="@style/CardHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="@dimen/size_status_dot"
                    android:layout_height="@dimen/size_status_dot"
                    android:background="@drawable/dot_connected" />

                <TextView
                    android:id="@+id/status_label"
                    style="@style/TextTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    tools:text="Active" />

                <TextView
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_body"
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textSize="14sp"
                tools:text="Turtle is your keyboard. Open any text field and slash to start." />

            <LinearLayout
                android:id="@+id/onboarding_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <Button
                    android:id="@+id/btn_enable"
                    style="@style/ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Turtle Keyboard" />

                <Button
                    android:id="@+id/btn_choose"
                    style="@style/ButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Switch to Turtle" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Section header ===== -->

        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Explore" />

        <!-- ===== Drill-in: Commands ===== -->

        <LinearLayout
            android:id="@+id/card_commands"
            style="@style/CardClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextCommandLarge"
                    android:textColor="@color/green"
                    android:text="⌘  Commands" />

                <ImageView
                    android:layout_width="@dimen/size_icon_sm"
                    android:layout_height="@dimen/size_icon_sm"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/commands_summary"
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="12 ready · 3 pinned" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/cap" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/edit" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/poll" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/us" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/wyr" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="/fix" />

                    <TextView style="@style/ChipMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:text="+6 more" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ===== Drill-in: Integrations ===== -->

        <LinearLayout
            android:id="@+id/card_integrations"
            style="@style/CardClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextCommandLarge"
                    android:textColor="@color/green"
                    android:text="🔗  Integrations" />

                <ImageView
                    android:layout_width="@dimen/size_icon_sm"
                    android:layout_height="@dimen/size_icon_sm"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/integrations_summary"
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="2 of 4 connected" />

            <LinearLayout
                android:id="@+id/integrations_dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_md">
                <!-- Filled at runtime. -->
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Drill-in: History ===== -->

        <LinearLayout
            android:id="@+id/card_history"
            style="@style/CardClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextCommandLarge"
                    android:textColor="@color/green"
                    android:text="🖼  History" />

                <ImageView
                    android:layout_width="@dimen/size_icon_sm"
                    android:layout_height="@dimen/size_icon_sm"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Everything you've generated, in one place." />
        </LinearLayout>

        <!-- ===== Drill-in: Settings ===== -->

        <LinearLayout
            android:id="@+id/card_settings"
            style="@style/CardClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextCommandLarge"
                    android:textColor="@color/green"
                    android:text="⚙  Settings" />

                <ImageView
                    android:layout_width="@dimen/size_icon_sm"
                    android:layout_height="@dimen/size_icon_sm"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_summary"
                style="@style/TextBodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="Account · Privacy · Appearance" />
        </LinearLayout>

        <!-- ===== Footer ===== -->

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/border_hairline"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/TextCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open source"
                android:textAllCaps="false" />

            <TextView
                style="@style/TextMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:text="🐢 — for the type-y people" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
