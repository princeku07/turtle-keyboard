<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode shares the same palette — landing page and keyboard panels are
         neo-brutalist, not theme-adaptive. Revisit when product wants a dark surface. -->
    <style name="Theme.TurtleKeyboard" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorPrimary">@color/lime</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/pink</item>
    </style>
</resources>
