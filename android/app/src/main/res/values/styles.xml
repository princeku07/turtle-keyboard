<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Section header in all-caps used at the top of each card row group. -->
    <style name="TextSectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="TextHero">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextSubhero">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextBodyMuted">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Big primary CTA. Lime fill, ink shadow + border, ink text. -->
    <style name="ButtonBrutalPrimary" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="ButtonBrutalSecondary" parent="ButtonBrutalPrimary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
    </style>

    <style name="ButtonBrutalAccent" parent="ButtonBrutalPrimary">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Card container — outline + offset shadow. Use as background on a LinearLayout
         and reserve 4dp right+bottom margin so the shadow fits without clipping. -->
    <style name="CardBrutal">
        <item name="android:background">@drawable/bg_card_brutal</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="EditTextBrutal" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/bg_input_brutal</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
