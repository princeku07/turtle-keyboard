<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Host app palette. Mirrors the keyboard chrome: pure black background, bright
         green accent, light text. Legacy `cream`/`ink`/`lime`/`pink`/etc. tokens are
         kept so MCP screens and existing modules don't break — they're remapped to
         dark-friendly values where they appear in UI. -->

    <!-- Surfaces -->
    <color name="bg_root">#FF000000</color>
    <color name="bg_card">#FF0F0F0F</color>
    <color name="bg_card_pressed">#FF14151A</color>
    <color name="bg_input">#FF0A0A0A</color>
    <color name="border_subtle">#FF1F1F1F</color>
    <color name="border_focus">#FF2A2D33</color>

    <!-- Text -->
    <color name="text_primary">#FFF5F5F5</color>
    <color name="text_secondary">#FF9A9A9A</color>
    <color name="text_tertiary">#FF5C5C5C</color>
    <color name="text_on_green">#FF00140A</color>

    <!-- Accent green — the brand signal, matches the keyboard's primary accent. -->
    <color name="green">#FF22C55E</color>
    <color name="green_pressed">#FF16A34A</color>
    <color name="green_glow">#2922C55E</color>

    <!-- Brand + onboarding tokens are generated into colors_tokens.xml by
         design-system/build.mjs. Edit tokens.json, regenerate. -->

    <!-- Status semantics -->
    <color name="status_connected">#FF22C55E</color>
    <color name="status_pending">#FFEAB308</color>
    <color name="status_error">#FFEF4444</color>

    <!-- Legacy brand tokens (kept for backward compat with modules that reference
         them directly — keyboard XML, other gradle modules). cream now reads as
         primary text so any leftover use renders correctly on dark. ink is unchanged
         since it's already near-black. -->
    <color name="cream">#FFF5F5F5</color>
    <color name="ink">#FF0C0C0C</color>
    <color name="lime">#FF22C55E</color>
    <color name="pink">#FFFF4FA3</color>
    <color name="blue">#FF5B6CFF</color>
    <color name="orange">#FFFF7A1A</color>
    <color name="muted">#FF9A9A9A</color>
    <color name="surface">#FF0F0F0F</color>

    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
