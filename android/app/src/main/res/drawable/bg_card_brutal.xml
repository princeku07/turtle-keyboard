<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface. Modern dark replacement for the old brutalist offset-shadow card.
     Kept the same filename so existing layouts (MCP screens, etc.) inherit the
     new look without edits. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/border_subtle" />
    <corners android:radius="16dp" />
</shape>
