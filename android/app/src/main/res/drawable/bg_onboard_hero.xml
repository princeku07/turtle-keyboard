<?xml version="1.0" encoding="utf-8"?>
<!-- Shared hero backdrop for all onboarding pages — a soft three-stop diagonal
     gradient. Real per-page artwork sits on top; this layer guarantees a
     coherent look even when an asset hasn't loaded yet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="225"
        android:startColor="@color/onboard_hero_top"
        android:centerColor="@color/onboard_hero_mid"
        android:endColor="@color/onboard_hero_bottom" />
</shape>
