<?xml version="1.0" encoding="utf-8"?>
<!-- Hero status card. Slightly elevated tone vs the neutral card, with a thin
     green-tinted border so the dashboard's top card commands attention. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/green_glow" />
    <corners android:radius="@dimen/radius_card" />
</shape>
