<?xml version="1.0" encoding="utf-8"?>
<!-- Used by KeyboardView via android:keyBackground. KeyboardView reuses one drawable per
     key, so every key shares this look. White face, soft mint press wash. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9EFE2" />
            <corners android:radius="10dp" />
            <padding android:left="2dp" android:right="2dp"
                     android:top="3dp" android:bottom="3dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E1ECE5" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="10dp" />
                    <padding android:left="2dp" android:right="2dp"
                             android:top="3dp" android:bottom="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
