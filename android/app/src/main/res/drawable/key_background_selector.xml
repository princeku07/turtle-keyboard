<?xml version="1.0" encoding="utf-8"?>
<!-- Used by KeyboardView via android:keyBackground. KeyboardView reuses one drawable per
     key, so we can't vary per-key here; function keys are styled via their own
     custom-rendered overlay in code. This is the unified per-key background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D8C40" />
            <corners android:radius="8dp" />
            <padding android:left="2dp" android:right="2dp"
                     android:top="3dp" android:bottom="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E7D32" />
            <corners android:radius="8dp" />
            <padding android:left="2dp" android:right="2dp"
                     android:top="3dp" android:bottom="3dp" />
        </shape>
    </item>
</selector>
