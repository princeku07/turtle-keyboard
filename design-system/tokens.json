{
  "$schema": "./tokens.schema.json",

  "brand": {
    "green":      { "$value": "#008658", "$type": "color" },
    "green-deep": { "$value": "#0E5C2C", "$type": "color" },
    "dot-gold":   { "$value": "#D9CBA0", "$type": "color" }
  },

  "onboard": {
    "bg":            { "$value": "#F1F5E8", "$type": "color" },
    "hero-top":      { "$value": "#DDE7F4", "$type": "color" },
    "hero-mid":      { "$value": "#F3EAF6", "$type": "color" },
    "hero-bottom":   { "$value": "#E8F0E2", "$type": "color" },
    "title":         { "$value": "#0C0C0C", "$type": "color" },
    "subtitle":      { "$value": "#6B6B6B", "$type": "color" },
    "cta-bg":        { "$value": "#0C0C0C", "$type": "color" },
    "cta-text":      { "$value": "#FFFFFF", "$type": "color" },
    "dot-active":    { "$value": "#0C0C0C", "$type": "color" },
    "dot-inactive":  { "$value": "#CDD3C2", "$type": "color" }
  },

  "space": {
    "xs":  { "$value": "4px",  "$type": "dimension" },
    "sm":  { "$value": "8px",  "$type": "dimension" },
    "md":  { "$value": "12px", "$type": "dimension" },
    "lg":  { "$value": "16px", "$type": "dimension" },
    "xl":  { "$value": "20px", "$type": "dimension" },
    "2xl": { "$value": "24px", "$type": "dimension" },
    "3xl": { "$value": "32px", "$type": "dimension" },
    "4xl": { "$value": "40px", "$type": "dimension" }
  },

  "text": {
    "display": {
      "$value": {
        "fontFamily":    "system",
        "fontWeight":    900,
        "fontSize":      "28px",
        "lineHeight":    1.1,
        "letterSpacing": "0"
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontFamily":    "system",
        "fontWeight":    400,
        "fontSize":      "15px",
        "lineHeight":    1.4,
        "letterSpacing": "0"
      },
      "$type": "typography"
    },
    "button": {
      "$value": {
        "fontFamily":    "system",
        "fontWeight":    500,
        "fontSize":      "16px",
        "lineHeight":    1.0,
        "letterSpacing": "0.02em"
      },
      "$type": "typography"
    }
  }
}
