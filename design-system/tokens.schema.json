{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle-keyboard.dev/schemas/design-system.json",
  "title": "Turtle Keyboard Design System",
  "description": "W3C-Design-Tokens-aligned schema. Leaves carry $value + $type; intermediate keys group tokens.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "patternProperties": {
    "^(?!\\$)[a-z0-9][a-z0-9-]*$": {
      "$ref": "#/$defs/group"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "patternProperties": {
        "^(?!\\$)[a-z0-9][a-z0-9-]*$": {
          "oneOf": [
            { "$ref": "#/$defs/token" },
            { "$ref": "#/$defs/group" }
          ]
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": ["$value", "$type"],
      "properties": {
        "$value": {},
        "$type": {
          "type": "string",
          "enum": ["color", "dimension", "fontFamily", "fontWeight", "duration", "cubicBezier", "shadow", "typography"]
        },
        "$description": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if":   { "properties": { "$type": { "const": "color" } } },
          "then": { "properties": { "$value": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" } } }
        },
        {
          "if":   { "properties": { "$type": { "const": "dimension" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?(px|pt|rem|em)$" },
                  { "type": "number" }
                ]
              }
            }
          }
        },
        {
          "if":   { "properties": { "$type": { "const": "typography" } } },
          "then": {
            "properties": {
              "$value": {
                "type": "object",
                "required": ["fontFamily", "fontWeight", "fontSize", "lineHeight"],
                "properties": {
                  "fontFamily":    { "type": "string" },
                  "fontWeight":    { "type": ["string", "number"] },
                  "fontSize":      { "type": ["string", "number"] },
                  "lineHeight":    { "type": ["string", "number"] },
                  "letterSpacing": { "type": ["string", "number"] }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
