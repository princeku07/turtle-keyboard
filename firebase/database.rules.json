{
  "rules": {
    "polls": {
      "$pollId": {
        ".read": true,
        ".write": "!data.exists() && auth != null && newData.child('createdByUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['question', 'options', 'createdByUid', 'createdAt', 'expiresAt'])",
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "options": {
          ".validate": "newData.hasChildren()",
          "$idx": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          }
        },
        "voters": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          }
        },
        "createdByUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
