# Turtle Keyboard — shared secrets / environment configuration.
#
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# Both the Android (`android/split/build.gradle.kts`) and the iOS build read
# from `.env` via the loader script in `tools/load-env.sh`, so credentials
# only live in ONE place across the repo.
#
# Format: KEY=VALUE per line. No quotes, no `export`. Lines starting with `#`
# are ignored. Whitespace around `=` is trimmed.

# Google OAuth Web Client ID (created at console.cloud.google.com → Credentials
# → OAuth 2.0 → "Web application"). Used by SplitAuth's authorization flow.
SPLIT_OAUTH_WEB_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com

# Notion OAuth credentials (register a "public integration" at
# https://www.notion.so/profile/integrations). Set the OAuth Domain & URLs →
# Redirect URI in Notion's dashboard to the same value below.
# NOTE: Notion REJECTS custom URL schemes — the redirect URI MUST be HTTPS. iOS
# uses an HTTPS bounce route on the Worker that redirects the code back into the
# turtleknotionoauth:// scheme (see ios/OAUTH_SETUP_iOS.md §2b).
# NOTE: client secret currently ships in BuildConfig — fine for personal use,
# move the token exchange to a server-side worker before public release.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://turtle-worker.trtlk.workers.dev/oauth/notion

# Slack OAuth credentials (create an app at https://api.slack.com/apps).
# OAuth & Permissions → Redirect URLs: add the value below exactly.
# NOTE: Slack (like Notion) REJECTS custom URL schemes — Redirect URLs MUST be
# HTTPS. iOS uses an HTTPS bounce route on the Worker that redirects the code
# back into the turtleslackoauth:// scheme (see ios/OAUTH_SETUP_iOS.md §2b).
# User Token Scopes required: chat:write, channels:read, groups:read.
# Same security note as Notion — secret in BuildConfig is fine for personal use.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://turtle-worker.trtlk.workers.dev/oauth/slack

# Google Gemini API key (https://aistudio.google.com/app/apikey). Used by the
# iOS keyboard extension's GoogleProvider + GeminiLlmService for /poll, /wyr,
# /notion, /fix, /tone, /reply, /tl, /ask, /org. Leave empty to fall back to
# the local LM Studio endpoint.
GEMINI_API_KEY=

# AI provider configuration. The `:ai` module talks to any OpenAI-API-compatible
# endpoint — swap providers (Mistral, OpenAI, Together, Groq, OpenRouter, local
# LM Studio, …) by changing AI_BASE_URL + AI_*_MODEL. Defaults below target Mistral.
# Used by ctx.llm() and ctx.images() across every feature module.
# Leave AI_IMAGE_MODEL empty if the chosen provider doesn't support image gen.
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_TEXT_MODEL=mistral-small-latest
AI_IMAGE_MODEL=
