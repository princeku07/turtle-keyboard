# Turtle Keyboard — shared secrets / environment configuration.
#
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# Both the Android (`android/split/build.gradle.kts`) and the iOS build read
# from `.env` via the loader script in `tools/load-env.sh`, so credentials
# only live in ONE place across the repo.
#
# Format: KEY=VALUE per line. No quotes, no `export`. Lines starting with `#`
# are ignored. Whitespace around `=` is trimmed.

# Google OAuth Web Client ID (created at console.cloud.google.com → Credentials
# → OAuth 2.0 → "Web application"). Used by SplitAuth's authorization flow.
SPLIT_OAUTH_WEB_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com

# Notion OAuth credentials (register a "public integration" at
# https://www.notion.so/profile/integrations). Set the OAuth Domain & URLs →
# Redirect URI in Notion's dashboard to the same value below.
# NOTE: client secret currently ships in BuildConfig — fine for personal use,
# move the token exchange to a server-side worker before public release.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://www.turtlekeyboard.com/oauth/notion
