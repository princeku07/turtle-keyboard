{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turtle Keyboard command",
  "description": "Schema every commands/<id>.yaml is validated against by CI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "owner", "input", "output", "contract", "ux", "support"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase kebab-case identifier. Must match the YAML filename."
    },
    "name": {
      "type": "string",
      "pattern": "^/[a-z][a-z0-9-]*$",
      "description": "User-facing slash command, e.g. /fix"
    },
    "summary": { "type": "string", "maxLength": 100 },
    "description": { "type": "string" },
    "owner": { "type": "string", "description": "GitHub handle or team responsible for this command." },
    "tags": { "type": "array", "items": { "type": "string" } },

    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "example"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["text", "image", "voice", "selection", "clipboard"] }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "string" }
      }
    },

    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "image", "audio", "mixed"] },
        "format": { "type": "string" },
        "example": { "type": "string" }
      }
    },

    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string" },
        "request_schema": { "type": "string" },
        "response_schema": { "type": "string" }
      }
    },

    "ux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_budget_ms", "loading_state", "error_state", "result_action"],
      "properties": {
        "latency_budget_ms": { "type": "integer", "minimum": 100 },
        "loading_state": { "enum": ["required", "optional", "none"] },
        "error_state": { "enum": ["required", "optional"] },
        "result_action": {
          "enum": ["copy-to-clipboard", "insert-inline", "replace-selection", "open-sheet"]
        },
        "privacy_notice": { "enum": ["required", "not-required"] }
      }
    },

    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "request", "response"],
        "properties": {
          "name": { "type": "string" },
          "request": { "type": "string" },
          "response": { "type": "string" }
        }
      }
    },

    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android", "ios", "backend"],
      "properties": {
        "android": { "$ref": "#/$defs/platformSupport" },
        "ios": { "$ref": "#/$defs/platformSupport" },
        "backend": { "$ref": "#/$defs/platformSupport" }
      }
    }
  },

  "$defs": {
    "platformSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["planned", "in-progress", "beta", "stable", "deprecated"]
        },
        "since": { "type": ["string", "null"] },
        "impl": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["beta", "stable"] } } },
          "then": {
            "required": ["since", "impl"],
            "properties": {
              "since": { "type": "string" },
              "impl": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
